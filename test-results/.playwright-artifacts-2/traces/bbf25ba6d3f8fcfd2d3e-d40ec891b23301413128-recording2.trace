ine-height: 1.1;\n  }\n  .print-header h1 span {\n    font-weight: 400;\n    font-size: 14px;\n    color: #777;\n    margin-left: 8px;\n  }\n  .print-date {\n    font-size: 8.5px;\n    color: #999;\n    margin: 0;\n  }\n  .print-summary {\n    display: flex;\n    align-items: center;\n    background: #f4f8f4;\n    border: 1px solid #c5d8c5;\n    border-radius: 6px;\n    padding: 8px 16px;\n    margin-bottom: 14px;\n    gap: 0;\n  }\n  .print-summary-cell {\n    flex: 1;\n    text-align: center;\n  }\n  .print-summary-divider {\n    width: 1px;\n    height: 28px;\n    background: #c5d8c5;\n  }\n  .print-summary-label {\n    font-size: 7.5px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    color: #888;\n    margin-bottom: 2px;\n  }\n  .print-summary-value {\n    font-size: 13px;\n    font-weight: 700;\n    color: #1a1a1a;\n  }\n  .print-summary-total {\n    color: #2d5a27;\n    font-size: 15px;\n  }\n  .print-category {\n    margin-bottom: 10px;\n    page-break-inside: avoid;\n  }\n  .print-cat-header {\n    background: #3c5a3c;\n    color: #fff;\n    font-size: 8.5px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.2px;\n    padding: 3px 8px;\n    margin-bottom: 0;\n  }\n  .print-col-headers {\n    display: flex;\n    align-items: center;\n    font-size: 7px;\n    font-weight: 600;\n    color: #aaa;\n    text-transform: uppercase;\n    letter-spacing: 0.4px;\n    padding: 2px 4px;\n    border-bottom: 1px solid #e0e0e0;\n  }\n  .print-item {\n    display: flex;\n    align-items: center;\n    font-size: 12px;\n    padding: 3px 4px;\n    border-bottom: 1px solid #f0f0f0;\n  }\n  .print-item-alt {\n    background: #f8fbf8;\n  }\n  .pcol-check {\n    width: 22px;\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n  }\n  .pcol-type {\n    width: 90px;\n    flex-shrink: 0;\n  }\n  .pcol-desc {\n    flex: 1;\n  }\n  .pcol-weight {\n    width: 64px;\n    flex-shrink: 0;\n    text-align: rig